graph TD
    subgraph BOOT["Bootstrap"]
        INIT["PetclinicInitializer\n(PetclinicInitializer.java)"]
    end

    subgraph CFG["Infrastructure / Config"]
        BIZ["business-config.xml"]
        MVC["mvc-core-config.xml"]
        TOOLS["tools-config.xml"]
        DS["datasource-config.xml"]
        DB["db/*/schema.sql + data.sql"]
        MSG["messages/messages*.properties"]
    end

    subgraph MODEL["Domain Model"]
        BASE["BaseEntity / NamedEntity / Person"]
        OWNER["Owner"]
        PET["Pet + PetType"]
        VET["Vet + Vets + Specialty"]
        VISIT["Visit"]
    end

    subgraph REPO_IF["Repository Interfaces"]
        OWN_IF["OwnerRepository"]
        PET_IF["PetRepository"]
        VET_IF["VetRepository"]
        VIS_IF["VisitRepository"]
    end

    subgraph REPO_JDBC["Repository — JDBC (profile: jdbc)"]
        JDBC_OWN["JdbcOwnerRepositoryImpl"]
        JDBC_PET["JdbcPetRepositoryImpl"]
        JDBC_VET["JdbcVetRepositoryImpl"]
        JDBC_VIS["JdbcVisitRepositoryImpl"]
        JDBC_UTIL["JdbcPet / Mappers / Extractors"]
    end

    subgraph REPO_JPA["Repository — JPA (profile: jpa)"]
        JPA_OWN["JpaOwnerRepositoryImpl"]
        JPA_PET["JpaPetRepositoryImpl"]
        JPA_VET["JpaVetRepositoryImpl"]
        JPA_VIS["JpaVisitRepositoryImpl"]
    end

    subgraph REPO_SD["Repository — Spring Data JPA (profile: spring-data-jpa)"]
        SD_OWN["SpringDataOwnerRepository"]
        SD_PET["SpringDataPetRepository"]
        SD_VET["SpringDataVetRepository"]
        SD_VIS["SpringDataVisitRepository"]
    end

    subgraph SVC["Service Layer"]
        SVC_IF["ClinicService (interface)"]
        SVC_IMPL["ClinicServiceImpl"]
    end

    subgraph WEB["Web / MVC"]
        OWN_CTL["OwnerController"]
        PET_CTL["PetController"]
        VET_CTL["VetController"]
        VIS_CTL["VisitController"]
        CRASH["CrashController"]
        FMT["PetTypeFormatter"]
        VAL["PetValidator"]
    end

    subgraph VIEW["View Layer (JSP + Tags)"]
        JSP_OWN["jsp/owners/*.jsp"]
        JSP_PET["jsp/pets/*.jsp"]
        JSP_VET["jsp/vets/vetList.jsp"]
        JSP_EX["jsp/exception.jsp"]
        TAGS["WEB-INF/tags/*.tag"]
    end

    subgraph AOP["Cross-Cutting Concerns"]
        ASPECT["CallMonitoringAspect (JMX)"]
        EUTIL["EntityUtils"]
    end

    INIT --> BIZ
    INIT --> MVC
    INIT --> TOOLS
    BIZ --> DS
    DS --> DB

    BASE --> OWNER
    BASE --> PET
    BASE --> VET
    BASE --> VISIT
