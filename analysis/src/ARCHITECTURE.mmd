    OWN_IF --> OWNER
    PET_IF --> PET
    VET_IF --> VET
    VIS_IF --> VISIT

    JDBC_OWN --> OWN_IF
    JDBC_PET --> PET_IF
    JDBC_VET --> VET_IF
    JDBC_VIS --> VIS_IF
    JDBC_OWN --> JDBC_UTIL
    JDBC_PET --> JDBC_UTIL
    JDBC_OWN --> EUTIL

    JPA_OWN --> OWN_IF
    JPA_PET --> PET_IF
    JPA_VET --> VET_IF
    JPA_VIS --> VIS_IF

    SD_OWN --> OWN_IF
    SD_PET --> PET_IF
    SD_VET --> VET_IF
    SD_VIS --> VIS_IF

    SVC_IMPL --> SVC_IF
    SVC_IMPL --> OWN_IF
    SVC_IMPL --> PET_IF
    SVC_IMPL --> VET_IF
    SVC_IMPL --> VIS_IF

    OWN_CTL --> SVC_IF
    PET_CTL --> SVC_IF
    VET_CTL --> SVC_IF
    VIS_CTL --> SVC_IF
    FMT --> SVC_IF

    OWN_CTL --> JSP_OWN
    PET_CTL --> JSP_PET
